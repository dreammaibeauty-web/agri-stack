  <style>
    :root {
      --primary: #0B6E4F;
      --primary-dark: #074F38;
      --primary-light: #E8F5F0;
      --accent: #D97706;
      --bg-page: #FAF9F6;
      --bg-surface: #FFFFFF;
      --bg-subtle: #F3F4F1;
      --text-main: #1C2522;
      --text-muted: #4B5954;
      --border: #DCE2DF;
      --shadow-sm: 0 2px 8px rgba(11, 110, 79, 0.06);
      --shadow-md: 0 8px 24px rgba(11, 110, 79, 0.08);
      --radius: 12px;
      --max-w: 1140px;
    }

    *, *::before, *::after {
      box-sizing: border-box;
    }

    html {
      scroll-behavior: smooth;
      font-size: 16px;
    }

    body {
      margin: 0;
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
      color: var(--text-main);
      background-color: var(--bg-page);
      line-height: 1.65;
      -webkit-font-smoothing: antialiased;
    }

    h1, h2, h3 {
      font-family: 'Merriweather', Georgia, serif;
      color: var(--text-main);
      line-height: 1.28;
      margin-top: 0;
    }

    h1 { font-size: clamp(1.85rem, 3.6vw, 2.75rem); font-weight: 900; margin-bottom: 1rem; }
    h2 { font-size: clamp(1.45rem, 2.6vw, 2rem); font-weight: 700; margin-bottom: 1.25rem; }
    h3 { font-size: 1.18rem; font-weight: 700; margin-bottom: 0.65rem; }

    p { margin-top: 0; margin-bottom: 1rem; }

    a {
      color: var(--primary);
      text-decoration: underline;
      text-underline-offset: 3px;
    }

    a:hover { color: var(--primary-dark); }

    img {
      max-width: 100%;
      height: auto;
      display: block;
    }

    .container {
      width: 100%;
      max-width: var(--max-w);
      margin: 0 auto;
      padding: 0 1.25rem;
    }

    /* Skip Link */
    .skip-link {
      position: absolute;
      left: -9999px;
      top: 0.75rem;
      background: var(--primary);
      color: #fff;
      padding: 0.65rem 1rem;
      border-radius: 6px;
      font-weight: 600;
      z-index: 1000;
    }
    .skip-link:focus { left: 1rem; }

    /* Header & Pure CSS Mobile Drawer */
    .site-header {
      position: sticky;
      top: 0;
      z-index: 100;
      background: rgba(255, 255, 255, 0.96);
      backdrop-filter: blur(8px);
      border-bottom: 1px solid var(--border);
    }

    .header-inner {
      display: flex;
      align-items: center;
      justify-content: space-between;
      min-height: 68px;
      position: relative;
    }

    .logo {
      display: inline-flex;
      align-items: center;
      gap: 0.55rem;
      font-family: 'Merriweather', serif;
      font-weight: 900;
      font-size: 1.15rem;
      color: var(--text-main);
      text-decoration: none;
    }

    .nav-checkbox {
      position: absolute;
      opacity: 0;
      pointer-events: none;
    }

    .nav-toggle-label {
      display: none;
      flex-direction: column;
      justify-content: center;
      gap: 5px;
      width: 40px;
      height: 40px;
      padding: 8px;
      border: 1px solid var(--border);
      border-radius: 8px;
      background: var(--bg-surface);
      cursor: pointer;
    }

    .nav-toggle-label span {
      display: block;
      height: 2px;
      width: 100%;
      background: var(--text-main);
      border-radius: 2px;
      transition: transform 0.2s ease, opacity 0.2s ease;
    }

    .primary-nav ul {
      list-style: none;
      margin: 0;
      padding: 0;
      display: flex;
      align-items: center;
      gap: 1.5rem;
    }

    .primary-nav a {
      text-decoration: none;
      color: var(--text-main);
      font-weight: 500;
      font-size: 0.95rem;
    }

    .primary-nav a:hover { color: var(--primary); }

    .primary-nav .nav-cta {
      background: var(--primary);
      color: #fff;
      padding: 0.55rem 1rem;
      border-radius: 8px;
      font-weight: 600;
    }

    .primary-nav .nav-cta:hover {
      background: var(--primary-dark);
      color: #fff;
    }

    @media (max-width: 820px) {
      .nav-toggle-label { display: flex; }

      .primary-nav {
        display: none;
        position: absolute;
        top: 68px;
        left: 0;
        right: 0;
        background: var(--bg-surface);
        border-bottom: 1px solid var(--border);
        box-shadow: var(--shadow-md);
        padding: 1rem 1.25rem 1.25rem;
      }

      .nav-checkbox:checked ~ .primary-nav {
        display: block;
      }

      .nav-checkbox:checked + .nav-toggle-label span:nth-child(1) {
        transform: translateY(7px) rotate(45deg);
      }
      .nav-checkbox:checked + .nav-toggle-label span:nth-child(2) {
        opacity: 0;
      }
      .nav-checkbox:checked + .nav-toggle-label span:nth-child(3) {
        transform: translateY(-7px) rotate(-45deg);
      }

      .primary-nav ul {
        flex-direction: column;
        align-items: flex-start;
        gap: 0.9rem;
      }

      .primary-nav .nav-cta {
        display: inline-block;
        margin-top: 0.25rem;
      }
    }

    /* Sections */
    section { padding: 3.5rem 0; }

    /* Hero */
    .hero {
      padding: 3.25rem 0 2.5rem;
      background: linear-gradient(180deg, #F1F8F5 0%, var(--bg-page) 100%);
      border-bottom: 1px solid var(--border);
    }

    .hero-grid {
      display: grid;
      grid-template-columns: 1.15fr 0.85fr;
      gap: 2.5rem;
      align-items: center;
