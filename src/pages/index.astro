      font-size: 0.86rem;
      color: var(--text-muted);
      margin: 0;
    }

    .apply-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 1.5rem;
      margin-top: 1.5rem;
    }

    @media (max-width: 780px) {
      .apply-grid { grid-template-columns: 1fr; }
    }

