---
// src/pages/index.astro
const pageTitle = "Relieve Back Pain & Master Posture Correction | 5-Min Guide";
const pageDescription =
  "Evidence-based 5-minute daily movement routines, thoracic extension, core activation, and ergonomic workstation principles for back pain relief and posture correction.";

const siteUrl = "https://dreammaibeauty-web-health-site.vercel.app";
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).toString();

const faqs = [
  {
    q: "How long does it take to see posture improvements?",
    a: "Most individuals experience reduced muscle tension within 7 to 10 days of daily targeted stretching. Noticeable structural posture alignment typically occurs within 4 to 6 weeks.",
  },
  {
    q: "What is the best sleeping position for lower back pain?",
    a: "Sleeping on your back with a small pillow under your knees maintains the natural lumbar curve. Side sleepers should place a supportive pillow between their knees.",
  },
  {
    q: "Can a 5-minute daily routine really help back pain?",
    a: "A short daily routine can reduce stiffness and build consistency, especially when it targets thoracic mobility, core activation, and workstation setup. Severe or persistent pain should be assessed by a clinician.",
  },
  {
    q: "How often should I adjust my workstation?",
    a: "Reset your workstation at the start of each work block, and take a 1–2 minute movement break every 30–45 minutes. Consistency matters more than a single perfect setup.",
  },
  {
    q: "When should I see a doctor for back pain?",
    a: "Seek clinical care for severe or worsening pain, numbness, weakness, loss of bladder or bowel control, unexplained weight loss, or pain after trauma. These can be red flags requiring urgent assessment.",
  },
];

const schemaData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": `${siteUrl}/#website`,
      "url": siteUrl,
      "name": "Health & Posture Guide",
      "description": pageDescription,
    },
    {
      "@type": "Organization",
      "@id": `${siteUrl}/#organization`,
      "name": "Health Guide Inc",
      "url": siteUrl,
    },
    {
      "@type": "Article",
      "@id": `${siteUrl}/#article`,
      "headline": pageTitle,
      "description": pageDescription,
      "mainEntityOfPage": canonicalUrl,
      "publisher": { "@id": `${siteUrl}/#organization` },
      "author": {
        "@type": "Person",
        "name": "[Clinician Name, Credentials]",
        "url": `${siteUrl}/about/`,
      },
      "datePublished": "2026-01-01",
      "dateModified": "2026-01-01",
    },
    {
      "@type": "FAQPage",
      "@id": `${siteUrl}/#faq`,
      "mainEntity": faqs.map(({ q, a }) => ({
        "@type": "Question",
        "name": q,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": a,
        },
      })),
    },
  ],
};
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="robots" content="index,follow" />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Required by output rules: load Tailwind via CDN and do not let Astro process it -->
    <script is:inline src="https://cdn.tailwindcss.com"></script>

    <script
      type="application/ld+json"
      set:html={JSON.stringify(schemaData)}
    ></script>
  </head>

  <body class="min-h-screen bg-slate-50 text-slate-800 antialiased">
    <!-- ============ PRIMARY NAV (no headings here) ============ -->
    <header
      class="sticky top-0 z-40 border-b border-slate-200/70 bg-white/80 backdrop-blur"
    >
      <nav
        class="mx-auto flex max-w-6xl items-center justify-between px-4 py-3 sm:px-6 lg:px-8"
        aria-label="Primary"
      >
        <a href="/" class="flex items-center gap-2 text-slate-900">
          <span
            class="flex h-9 w-9 items-center justify-center rounded-xl bg-gradient-to-br from-indigo-500 to-sky-500 text-white shadow-sm"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="h-5 w-5"
              aria-hidden="true"
            >
              <path d="M13 2 4 14h7l-1 8 9-12h-7l1-8Z"></path>
            </svg>
          </span>
          <span class="text-sm font-semibold tracking-tight"
            >Health &amp; Posture Guide</span
          >
        </a>

        <div
          class="hidden items-center gap-6 text-sm font-medium text-slate-600 md:flex"
        >
          <a href="#routine" class="hover:text-indigo-600">Routine</a>
          <a href="#comparison" class="hover:text-indigo-600">Compare</a>
          <a href="#faq" class="hover:text-indigo-600">FAQ</a>
          <a href="#related" class="hover:text-indigo-600">Resources</a>
        </div>

        <a
          href="#routine"
          class="inline-flex items-center gap-1.5 rounded-lg bg-indigo-600 px-3.5 py-2 text-sm font-semibold text-white shadow-sm ring-1 ring-inset ring-white/10 transition hover:bg-indigo-500"
        >
          Start routine
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="h-4 w-4"
            aria-hidden="true"
          >
            <path d="M5 12h14M13 5l7 7-7 7"></path>
          </svg>
        </a>
      </nav>
    </header>

    <main>
      <!-- ============ 1. HERO BANNER ============ -->
      <section
        id="top"
        class="relative overflow-hidden bg-gradient-to-b from-indigo-50 via-sky-50 to-slate-50"
      >
        <div
          class="pointer-events-none absolute -top-32 right-0 h-96 w-96 rounded-full bg-indigo-200/40 blur-3xl"
        >
        </div>
        <div
          class="pointer-events-none absolute -bottom-24 left-0 h-96 w-96 rounded-full bg-sky-200/40 blur-3xl"
        >
        </div>

        <div
          class="relative mx-auto max-w-6xl px-4 pb-24 pt-16 sm:px-6 lg:px-8 lg:pt-24"
        >
          <div class="mx-auto max-w-3xl text-center">
            <span
              class="inline-flex items-center gap-2 rounded-full border border-indigo-200 bg-white/70 px-3 py-1 text-xs font-semibold text-indigo-700 shadow-sm"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="h-4 w-4"
                aria-hidden="true"
              >
                <path
                  d="M12 3v4M12 17v4M3 12h4M17 12h4M5.6 5.6l2.8 2.8M15.6 15.6l2.8 2.8M5.6 18.4l2.8-2.8M15.6 8.4l2.8-2.8"
                ></path>
              </svg>
              Evidence-Informed · 2026 Guide
            </span>

            <h1
              class="mt-6 text-balance text-4xl font-black tracking-tight text-slate-900 sm:text-5xl lg:text-6xl"
            >
              Relieve Back Pain &amp; Master Posture Correction in 5 Minutes a
              Day
            </h1>

            <p
              class="mx-auto mt-5 max-w-2xl text-balance text-lg leading-relaxed text-slate-600"
            >
              Evidence-based daily movement routines, thoracic extension, core
              activation, and ergonomic workstation principles to reduce tension
              and improve posture — without complicated programs.
            </p>

            <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
              <a
                href="#routine"
                class="inline-flex items-center gap-2 rounded-xl bg-indigo-600 px-6 py-3 text-sm font-semibold text-white shadow-lg shadow-indigo-600/20 transition hover:bg-indigo-500"
              >
                Start the 5-minute routine
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class="h-4 w-4"
                  aria-hidden="true"
                >
                  <path d="M5 12h14M13 5l7 7-7 7"></path>
                </svg>
              </a>
              <a
                href="#answer"
                class="inline-flex items-center gap-2 rounded-xl border border-slate-300 bg-white px-6 py-3 text-sm font-semibold text-slate-700 shadow-sm transition hover:border-indigo-300 hover:text-indigo-700"
