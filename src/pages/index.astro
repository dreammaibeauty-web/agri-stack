  <!-- EMBEDDED PRODUCTION CSS (styles.css) -->
  <style>
    /* ==========================================================================
       1. DESIGN TOKENS & VARIABLES
       ========================================================================== */
    :root {
      --color-primary: #0B6E4F;
      --color-primary-dark: #074F38;
      --color-primary-light: #E8F4F0;
      --color-primary-border: #B7DEC9;
      --color-accent-warm: #D97706;
      --color-bg-body: #FAF9F5;
      --color-bg-surface: #FFFFFF;
      --color-bg-subtle: #F3F4F1;
      --color-text-main: #18221E;
      --color-text-muted: #475550;
      --color-text-light: #64746E;
      --color-border: #E2E8F0;
      --color-border-strong: #CBD5E1;

      --font-serif: 'Merriweather', Georgia, Cambria, "Times New Roman", serif;
      --font-sans: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;

      --radius-sm: 6px;
      --radius-md: 12px;
      --radius-lg: 16px;
      --radius-full: 9999px;

      --shadow-xs: 0 1px 2px rgba(11, 110, 79, 0.04);
      --shadow-sm: 0 2px 8px rgba(24, 34, 30, 0.05);
      --shadow-md: 0 8px 24px rgba(24, 34, 30, 0.08);

      --container-max: 1160px;
      --header-height: 72px;
      --transition-base: 0.2s cubic-bezier(0.16, 1, 0.3, 1);
    }

    /* ==========================================================================
       2. RESET & BASE TYPOGRAPHY
       ========================================================================== */
    *, *::before, *::after {
      box-sizing: border-box;
    }

    html {
      scroll-behavior: smooth;
      scroll-padding-top: calc(var(--header-height) + 24px);
      -webkit-text-size-adjust: 100%;
    }

    body {
      margin: 0;
      font-family: var(--font-sans);
      font-size: 1rem;
      line-height: 1.65;
      color: var(--color-text-main);
      background-color: var(--color-bg-body);
      -webkit-font-smoothing: antialiased;
      -moz-osx-font-smoothing: grayscale;
      overflow-x: hidden;
    }

    h1, h2, h3, h4 {
      font-family: var(--font-serif);
      color: var(--color-text-main);
      line-height: 1.25;
      margin-top: 0;
      letter-spacing: -0.015em;
    }

    h1 {
      font-size: clamp(1.85rem, 3.6vw, 2.75rem);
      font-weight: 900;
      margin-bottom: 1.25rem;
    }

    h2 {
      font-size: clamp(1.5rem, 2.6vw, 2.05rem);
      font-weight: 700;
      margin-bottom: 1.5rem;
    }

    h3 {
      font-size: 1.2rem;
      font-weight: 700;
      margin-bottom: 0.75rem;
    }

    p {
      margin-top: 0;
      margin-bottom: 1.1rem;
      color: var(--color-text-muted);
    }

    p:last-child {
      margin-bottom: 0;
    }

    strong {
      color: var(--color-text-main);
      font-weight: 600;
    }

    a {
      color: var(--color-primary);
      text-decoration: none;
      transition: color var(--transition-base);
    }

    a:hover {
      color: var(--color-primary-dark);
    }

    img {
      max-width: 100%;
      height: auto;
      display: block;
    }

    /* Accessibility Skip Link */
    .skip-link {
      position: absolute;
      top: -100px;
      left: 16px;
      background: var(--color-primary);
      color: #FFFFFF;
      padding: 10px 18px;
      border-radius: var(--radius-sm);
      font-weight: 600;
      z-index: 1000;
      transition: top 0.15s ease;
    }

    .skip-link:focus {
      top: 16px;
      color: #FFFFFF;
      outline: 3px solid var(--color-accent-warm);
    }

    /* Layout Container */
    .container {
      width: 100%;
      max-width: var(--container-max);
      margin-left: auto;
      margin-right: auto;
      padding-left: 1.25rem;
      padding-right: 1.25rem;
    }

    @media (min-width: 768px) {
      .container {
        padding-left: 2rem;
        padding-right: 2rem;
      }
    }

    /* ==========================================================================
       3. STICKY HEADER & PURE-CSS MOBILE NAVIGATION
       ========================================================================== */
    .site-header {
      position: sticky;
      top: 0;
      z-index: 900;
      background-color: rgba(255, 255, 255, 0.96);
      backdrop-filter: blur(10px);
      -webkit-backdrop-filter: blur(10px);
      border-bottom: 1px solid var(--color-border);
      box-shadow: var(--shadow-xs);
      height: var(--header-height);
    }

    .header-inner {
      display: flex;
      align-items: center;
      justify-content: space-between;
      height: 100%;
    }

    .logo {
      display: inline-flex;
      align-items: center;
      gap: 0.625rem;
      font-family: var(--font-serif);
      font-weight: 900;
      font-size: 1.2rem;
      color: var(--color-text-main);
      letter-spacing: -0.02em;
    }

    .logo:hover {
      color: var(--color-primary);
    }

    .logo svg {
      flex-shrink: 0;
      transition: transform var(--transition-base);
    }

    .logo:hover svg {
      transform: translateY(-1px) scale(1.05);
    }

    /* Visually hidden checkbox controlling mobile drawer */
    .nav-checkbox {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      margin: -1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
      border: 0;
    }

    /* Primary Desktop Nav */
    .primary-nav ul {
      display: flex;
      align-items: center;
      gap: 1.5rem;
      list-style: none;
      margin: 0;
      padding: 0;
    }

    .primary-nav a {
      font-size: 0.9375rem;
      font-weight: 500;
      color: var(--color-text-muted);
      padding: 0.4rem 0;
      position: relative;
    }

    .primary-nav a:not(.nav-cta):hover,
    .primary-nav a:not(.nav-cta):focus-visible {
      color: var(--color-primary);
    }

    .primary-nav a.nav-cta {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      background-color: var(--color-primary);
      color: #FFFFFF;
      font-weight: 600;
      font-size: 0.875rem;
      padding: 0.6rem 1.15rem;
      border-radius: var(--radius-sm);
      box-shadow: var(--shadow-xs);
      transition: background-color var(--transition-base), transform var(--transition-base);
    }

    .primary-nav a.nav-cta:hover {
      background-color: var(--color-primary-dark);
      color: #FFFFFF;
      transform: translateY(-1px);
    }

    /* Pure-CSS Mobile Hamburger Label */
    .nav-toggle-label {
      display: none;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      gap: 5px;
      width: 44px;
      height: 44px;
      padding: 8px;
      background: transparent;
      border: 1px solid var(--color-border);
      border-radius: var(--radius-sm);
      cursor: pointer;
      user-select: none;
    }

    .nav-toggle-label span {
      display: block;
      width: 22px;
      height: 2px;
      background-color: var(--color-text-main);
      border-radius: 2px;
      transition: transform 0.25s ease, opacity 0.2s ease;
    }

    .nav-checkbox:focus-visible + .nav-toggle-label {
      outline: 2px solid var(--color-primary);
      outline-offset: 2px;
    }

    .nav-checkbox:checked + .nav-toggle-label span:nth-child(1) {
      transform: translateY(7px) rotate(45deg);
    }

    .nav-checkbox:checked + .nav-toggle-label span:nth-child(2) {
      opacity: 0;
    }

    .nav-checkbox:checked + .nav-toggle-label span:nth-child(3) {
      transform: translateY(-7px) rotate(-45deg);
    }

    @media (max-width: 900px) {
      .nav-toggle-label {
        display: flex;
      }

      .primary-nav {
        position: fixed;
        top: var(--header-height);
        left: 0;
        right: 0;
        background-color: var(--color-bg-surface);
        border-bottom: 1px solid var(--color-border);
        box-shadow: var(--shadow-md);
        padding: 1.25rem;
        transform: translateY(-12px);
        opacity: 0;
        visibility: hidden;
        transition: opacity 0.2s ease, transform 0.2s ease, visibility 0.2s ease;
      }

      .nav-checkbox:checked ~ .primary-nav {
        transform: translateY(0);
        opacity: 1;
        visibility: visible;
      }

      .primary-nav ul {
        flex-direction: column;
        align-items: stretch;
        gap: 0.35rem;
      }

      .primary-nav a {
        display: block;
        padding: 0.75rem 0.5rem;
        font-size: 1rem;
        border-bottom: 1px solid var(--color-bg-subtle);
      }

      .primary-nav li:last-child a {
        border-bottom: none;
        margin-top: 0.5rem;
        text-align: center;
      }
    }

    /* ==========================================================================
       4. BUTTONS
       ========================================================================== */
    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.5rem;
      font-family: var(--font-sans);
      font-weight: 600;
      font-size: 1rem;
      padding: 0.875rem 1.5rem;
      border-radius: var(--radius-sm);
      border: none;
      cursor: pointer;
      transition: background-color var(--transition-base), transform var(--transition-base), box-shadow var(--transition-base);
    }

    .btn-primary {
      background-color: var(--color-primary);
      color: #FFFFFF;
      box-shadow: 0 4px 12px rgba(11, 110, 79, 0.22);
    }

    .btn-primary:hover {
      background-color: var(--color-primary-dark);
      color: #FFFFFF;
      transform: translateY(-2px);
      box-shadow: 0 6px 16px rgba(11, 110, 79, 0.28);
    }

    .btn-secondary {
      background-color: var(--color-bg-surface);
      color: var(--color-primary);
      border: 1.5px solid var(--color-primary);
    }

    .btn-secondary:hover {
      background-color: var(--color-primary-light);
    }

    /* ==========================================================================
       5. HERO SECTION
       ========================================================================== */
    .hero {
      padding: 3rem 0 3.5rem;
      background: linear-gradient(180deg, #FFFFFF 0%, var(--color-bg-body) 100%);
      border-bottom: 1px solid var(--color-border);
    }

    @media (min-width: 960px) {
      .hero {
        padding: 4.5rem 0 4.5rem;
      }
    }

    .hero-grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: 2.5rem;
      align-items: center;
    }

    @media (min-width: 960px) {
      .hero-grid {
        grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
        gap: 3.5rem;
      }
    }

    .hero-eyebrow {
      display: inline-flex;
      align-items: center;
      gap: 0.45rem;
      font-size: 0.8125rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      color: var(--color-primary);
      background-color: var(--color-primary-light);
      padding: 0.35rem 0.75rem;
      border-radius: var(--radius-full);
      margin-bottom: 1rem;
    }

    .hero-sub {
      font-size: 1.075rem;
      line-height: 1.7;
      color: var(--color-text-muted);
      margin-bottom: 1.75rem;
    }

    .hero-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 0.875rem;
      align-items: center;
    }

    .trust-signals {
      display: grid;
      grid-template-columns: 1fr;
      gap: 0.65rem;
      list-style: none;
      padding: 1.5rem 0 0;
      margin: 1.75rem 0 0;
      border-top: 1px solid var(--color-border);
      font-size: 0.875rem;
      font-weight: 500;
      color: var(--color-text-main);
    }

    @media (min-width: 560px) {
      .trust-signals {
        grid-template-columns: repeat(2, 1fr);
        gap: 0.75rem 1.25rem;
      }
    }

    .trust-signals li {
      display: flex;
      align-items: flex-start;
      gap: 0.5rem;
    }

    .hero-image {
      position: relative;
      border-radius: var(--radius-lg);
      overflow: hidden;
      box-shadow: var(--shadow-md);
      border: 1px solid var(--color-border);
      background: linear-gradient(135deg, #E8F4F0 0%, #D1EAE1 100%);
    }

    .hero-image img {
      width: 100%;
      aspect-ratio: 4 / 3;
      object-fit: cover;
    }

    .hero-caption {
      font-size: 0.8rem;
      color: var(--color-text-muted);
      background-color: var(--color-bg-surface);
      padding: 0.65rem 1rem;
      border-top: 1px solid var(--color-border);
    }

    /* ==========================================================================
       6. TL;DR ANSWER-FIRST CALLOUT
       ========================================================================== */
    .tldr-section {
      padding: 2.75rem 0 1.5rem;
    }

    .tldr-box {
      background-color: var(--color-primary-light);
      border: 1px solid var(--color-primary-border);
      border-left: 5px solid var(--color-primary);
      border-radius: var(--radius-md);
      padding: 1.75rem;
      box-shadow: var(--shadow-xs);
    }

    @media (min-width: 768px) {
      .tldr-box {
        padding: 2rem 2.25rem;
      }
    }

    .tldr-box h2 {
      font-size: 1.25rem;
      color: var(--color-primary-dark);
      margin-bottom: 0.65rem;
    }

    .tldr-box p {
      font-size: 1.03rem;
      color: var(--color-text-main);
      line-height: 1.7;
    }

    /* ==========================================================================
       7. THREE PILLARS SECTION
       ========================================================================== */
    .pillars {
      padding: 3.5rem 0;
    }

    .pillar-grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }

    @media (min-width: 860px) {
      .pillar-grid {
        grid-template-columns: repeat(3, 1fr);
        gap: 1.75rem;
      }
    }

    .pillar-card {
      background-color: var(--color-bg-surface);
      border: 1px solid var(--color-border);
      border-radius: var(--radius-md);
      padding: 1.75rem;
      box-shadow: var(--shadow-sm);
      display: flex;
      flex-direction: column;
      transition: transform var(--transition-base), box-shadow var(--transition-base), border-color var(--transition-base);
    }

    .pillar-card:hover {
      transform: translateY(-3px);
      box-shadow: var(--shadow-md);
      border-color: var(--color-primary-border);
    }

    .pillar-icon {
      width: 48px;
      height: 48px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      font-size: 1.5rem;
      background-color: var(--color-primary-light);
      border-radius: var(--radius-sm);
      margin-bottom: 1.15rem;
    }

    .pillar-card h3 {
      font-size: 1.15rem;
      margin-bottom: 0.85rem;
    }

    .pillar-card p {
      font-size: 0.95rem;
      margin-bottom: 0.9rem;
    }

    .pillar-card p:last-child {
      margin-bottom: 0;
    }

    /* ==========================================================================
       8. COMPARISON TABLE & KEY TAKEAWAYS
       ========================================================================== */
    .comparison {
      padding: 3.5rem 0;
      background-color: var(--color-bg-surface);
      border-top: 1px solid var(--color-border);
      border-bottom: 1px solid var(--color-border);
    }

    .table-wrapper {
      width: 100%;
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
      border: 1px solid var(--color-border);
      border-radius: var(--radius-md);
      box-shadow: var(--shadow-xs);
      margin-bottom: 2rem;
      background-color: var(--color-bg-surface);
    }

    table {
      width: 100%;
      min-width: 760px;
      border-collapse: collapse;
      text-align: left;
      font-size: 0.9375rem;
    }

    thead {
      background-color: var(--color-primary);
      color: #FFFFFF;
    }

    thead th {
      padding: 1rem 1.15rem;
      font-family: var(--font-sans);
      font-weight: 600;
      font-size: 0.875rem;
      letter-spacing: 0.02em;
      border-bottom: 2px solid var(--color-primary-dark);
    }

    thead th:nth-child(2) {
      background-color: var(--color-primary-dark);
    }

    tbody tr {
      border-bottom: 1px solid var(--color-border);
      transition: background-color 0.15s ease;
    }

    tbody tr:last-child {
