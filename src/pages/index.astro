                <th scope="col">Ceiling &amp; Repeat Cycle</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <th scope="row">Small &amp; Marginal (General States)</th>
                <td><strong>55%</strong> (+ State top-up up to 75–80% in select states)</td>
                <td>60 : 40 (Central : State)</td>
                <td>Drip, Micro-Sprinkler, Mini-Sprinkler, Portable &amp; Rain Gun</td>
                <td>Up to 5 Ha; re-eligible after 7 years</td>
              </tr>
              <tr>
                <th scope="row">Other Farmers (General States)</th>
                <td><strong>45%</strong> (+ State top-up up to 65–75% in select states)</td>
                <td>60 : 40 (Central : State)</td>
                <td>Drip, Micro-Sprinkler, Mini-Sprinkler, Portable &amp; Rain Gun</td>
                <td>Up to 5 Ha; re-eligible after 7 years</td>
              </tr>
              <tr>
                <th scope="row">Small &amp; Marginal (NE &amp; Himalayan States)</th>
                <td><strong>55%</strong> minimum baseline</td>
                <td>90 : 10 (Central : State)</td>
                <td>All approved BIS-certified micro-irrigation systems</td>
                <td>Up to 5 Ha; re-eligible after 7 years</td>
              </tr>
              <tr>
                <th scope="row">Union Territories (without Legislature)</th>
                <td><strong>55%</strong> (Small/Marginal) / <strong>45%</strong> (Others)</td>
                <td>100% Central Funding</td>
                <td>All approved BIS-certified micro-irrigation systems</td>
                <td>Up to 5 Ha; re-eligible after 7 years</td>
              </tr>
            </tbody>
