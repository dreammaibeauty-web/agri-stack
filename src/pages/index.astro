    }

    .tldr-box h2 {
      font-size: 1.3rem;
      margin-bottom: 0.65rem;
      color: var(--primary-dark);
    }

    .tldr-box p:last-child { margin-bottom: 0; }

    /* Three Pillars */
    .pillar-grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 1.5rem;
    }

    @media (max-width: 860px) {
      .pillar-grid { grid-template-columns: 1fr; }
    }

    .pillar-card {
      background: var(--bg-surface);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 1.65rem;
      box-shadow: var(--shadow-sm);
    }

    .pillar-icon {
      width: 44px;
      height: 44px;
      border-radius: 10px;
      background: var(--primary-light);
      display: inline-flex;
      align-items: center;
      justify-content: center;
      font-size: 1.35rem;
      margin-bottom: 1rem;
    }

    .pillar-card p:last-child { margin-bottom: 0; }

    /* Tables */
    .table-wrapper {
      overflow-x: auto;
      background: var(--bg-surface);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      box-shadow: var(--shadow-sm);
      margin-bottom: 1.75rem;
    }

    table {
      width: 100%;
      border-collapse: collapse;
      min-width: 660px;
      font-size: 0.94rem;
    }

    th, td {
      padding: 0.95rem 1.1rem;
      text-align: left;
      border-bottom: 1px solid var(--border);
      vertical-align: top;
    }

    thead th {
      background: var(--primary);
      color: #fff;
      font-weight: 600;
    }

    tbody tr:nth-child(even) { background: var(--bg-subtle); }
    tbody tr:last-child th, tbody tr:last-child td { border-bottom: none; }

    .takeaways {
      background: var(--primary-light);
      border: 1px solid rgba(11, 110, 79, 0.22);
      border-radius: var(--radius);
      padding: 1.4rem 1.65rem;
    }

    .takeaways h3 { color: var(--primary-dark); }
    .takeaways ul { margin: 0; padding-left: 1.25rem; }
    .takeaways li { margin-bottom: 0.45rem; }
    .takeaways li:last-child { margin-bottom: 0; }

    /* Subsidy Reference Section */
    .subsidy-section {
      background: var(--bg-subtle);
      border-top: 1px solid var(--border);
      border-bottom: 1px solid var(--border);
    }

    .subsidy-highlights {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 1.25rem;
      margin-bottom: 1.75rem;
    }

    @media (max-width: 780px) {
